{
  "info": {
    "name": "MSuite API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "msuite-api-collection",
    "description": "Postman collection for MSuite API"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health: Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
      }
    },
    {
      "name": "Health: Detailed",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Auth: Register",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\",\n  \"full_name\": \"Test User\",\n  \"role\": \"ECOMMERCE\"\n}"},
        "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api","v1","auth","register"] }
      }
    },
    {
      "name": "Auth: Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123!\"\n}"},
        "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api","v1","auth","login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Capture tokens from login response and store in environment",
              "try {",
              "  const data = pm.response.json();",
              "  if (data.access_token) { pm.environment.set('access_token', data.access_token); }",
              "  if (data.refresh_token) { pm.environment.set('refresh_token', data.refresh_token); }",
              "  pm.test('Login returns tokens', function () {",
              "    pm.expect(data).to.have.property('access_token');",
              "    pm.expect(data).to.have.property('refresh_token');",
              "  });",
              "} catch (e) {",
              "  console.warn('Token capture failed:', e);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth: Me",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api","v1","auth","me"] }
      }
    },
    {
      "name": "Auth: Logout",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api","v1","auth","logout"] }
      }
    },
    {
      "name": "Auth: Extend Session",
      "request": {
        "method": "POST",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/auth/extend-session", "host": ["{{base_url}}"], "path": ["api","v1","auth","extend-session"] }
      }
    },
    {
      "name": "Users: List",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/users", "host": ["{{base_url}}"], "path": ["api","v1","users"] }
      }
    },
    {
      "name": "Products: Create",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"name\": \"Premium T-Shirt\",\n  \"sku\": \"TSHIRT-001\",\n  \"price\": 29.99,\n  \"initial_quantity\": 100\n}"},
        "url": { "raw": "{{base_url}}/api/v1/products", "host": ["{{base_url}}"], "path": ["api","v1","products"] }
      }
    },
    {
      "name": "Products: List",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/products", "host": ["{{base_url}}"], "path": ["api","v1","products"] }
      }
    },
    {
      "name": "Orders: Create",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"CUSTOMER_UUID\",\n  \"items\": [{\n    \"product_id\": \"PRODUCT_UUID\",\n    \"quantity\": 2,\n    \"price\": 29.99\n  }],\n  \"shipping_cost\": 5.00,\n  \"tax_amount\": 5.40\n}"},
        "url": { "raw": "{{base_url}}/api/v1/orders", "host": ["{{base_url}}"], "path": ["api","v1","orders"] }
      }
    },
    {
      "name": "Orders: List",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/orders", "host": ["{{base_url}}"], "path": ["api","v1","orders"] }
      }
    },
    {
      "name": "Customers: List",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/customers", "host": ["{{base_url}}"], "path": ["api","v1","customers"] }
      }
    },
    {
      "name": "Cart: Add Item",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"customer_id\": \"CUSTOMER_UUID\",\n  \"product_id\": \"PRODUCT_UUID\",\n  \"quantity\": 2\n}"},
        "url": { "raw": "{{base_url}}/api/v1/cart/items", "host": ["{{base_url}}"], "path": ["api","v1","cart","items"] }
      }
    },
    {
      "name": "Cart: Get",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/cart/CUSTOMER_UUID", "host": ["{{base_url}}"], "path": ["api","v1","cart","CUSTOMER_UUID"] }
      }
    },
    {
      "name": "Coupons: Validate",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"code\": \"WELCOME10\",\n  \"cart_amount\": 75.00,\n  \"customer_id\": \"CUSTOMER_UUID\"\n}"},
        "url": { "raw": "{{base_url}}/api/v1/coupons/validate", "host": ["{{base_url}}"], "path": ["api","v1","coupons","validate"] }
      }
    },
    {
      "name": "Webhooks: List",
      "request": {
        "method": "GET",
        "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
        "url": { "raw": "{{base_url}}/api/v1/webhooks", "host": ["{{base_url}}"], "path": ["api","v1","webhooks"] }
      }
    }
  ]
}
