# Database Configuration
DATABASE_URL=postgresql://postgres:admin@localhost:5432/MSuite

# Security & JWT
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters-required
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=MSuite - E-Commerce BaaS

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
